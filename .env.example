# Binance Demo Trading API anahtarlari
# https://demo.binance.com -> ana Binance hesabinizla giris -> API Key Management
BINANCE_API_KEY=
BINANCE_API_SECRET=

# "demo" (sahte para, ONERILEN) | "legacy_testnet" (eski) | "live" (GERCEK PARA)
BINANCE_MODE=demo

# --- main.py (ana bot) icin ---
# mean_reversion (varsayilan), extreme_reversal, adaptive, trend_momentum, breakout
ACTIVE_STRATEGY=mean_reversion

# --- crosssec_bot.py (kesitsel bot) ayri calisir, parametreleri dosya icinde ---

# --- carry_bot.py ---
# Madde 656: boş bırakılırsa (ya da ONERILEN) bot bakiyeye göre önerilen ayarı seçer (ONERILEN.md):
#   < 3.500 $ T7K 1,15x · 3.500-12.500 $ T7K 1,10x · ≥ 12.500 $ T6 1,10x; hepsi koşullu stop 0,03. Kapatmak: CARRY_ONERILEN=0
# CARRY_PROFIL=ONERILEN

# Telegram bildirimleri (madde 670; isteğe bağlı — KURULUM_SUNUCU.md "Telegram"). Boşsa hiçbir şey gönderilmez.
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# CARRY_BILDIRIM_AD=demo-1
