# MADDE 746: piyasa tarayıcısı (tarayici.py) — panelin "Piyasa" sekmesi. API ANAHTARI KULLANMAZ, EMİR GÖNDERMEZ; botla bağı yok.
# Açmak:  sudo cp /opt/carry/deploy/carry-tarayici.* /etc/systemd/system/ && sudo systemctl daemon-reload &&
#         sudo systemctl enable --now carry-tarayici.timer
[Unit]
Description=Carry piyasa tarayıcısı (gerçek Binance, anahtarsız, salt okunur)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=carry
Group=carry
WorkingDirectory=/opt/carry
ExecStart=/opt/carry/.venv/bin/python tarayici.py
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/carry/defter
